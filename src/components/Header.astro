---
interface Props {
    Pagina:string;
}

import {Image} from 'astro:assets';
import ramble_logo from '../assets/ramble_logo.svg';

const { Pagina } = Astro.props;
---

<header class="mainHeader" data-astro-reload>
    <Image src={ramble_logo} alt={"Ramble logo"} class="mainHeader_Logo"> </Image> 

    <!--The button to open the menu for mobile users -->
    <button class="mainHeader_MobileButton">MENU</button>

    <nav class="mainHeader_Nav">
        <a href="/" class=`nav_Link ${Pagina == 'inicio' ? 'nav_Link_Active' : 'nav_Link' }`>Inicio</a>
        <a href="/guias" class=`nav_Link ${Pagina == 'guias' ? 'nav_Link_Active' : 'nav_Link' }`>Guías</a>
        <a href="/eventos" class=`nav_Link ${Pagina == 'eventos' ? 'nav_Link_Active' : 'nav_Link' }`>Eventos</a>
        <a href="/noticias" class=`nav_Link ${Pagina == 'noticias' ? 'nav_Link_Active' : 'nav_Link' }`>Noticias</a>
        <!-- <a href="" class=`nav_Link ${Pagina == 'shop' ? 'nav_Link_Active' : 'nav_Link' }`>Tienda</a> -->
        <a href="/FAQ" class=`nav_Link ${Pagina == 'FAQ' ? 'nav_Link_Active' : 'nav_Link' }`>FAQ</a>
        <a href="/reportar" class=`nav_Link ${Pagina == 'reportar' ? 'nav_Link_Active' : 'nav_Link' }`>Reportar</a>
    </nav>

    <button class="mainHeader_PlayButton" id="IPButton">UNETE</button>
</header>


<script>

        function copiarIP() {
            navigator.clipboard.writeText("ramblemc.com:4000")
            window.alert("¡IP copiada correctamente!")
        }

        function MenuMovil () {
            if (!MainHeaderNav?.classList.contains("mainHeader_Nav_MobileActive")){
                OpenMobileMenuButton.classList.add("mainHeader_MobileButton_Active")
                MainHeaderNav.classList.add("mainHeader_Nav_MobileActive");
                console.log(MainHeaderNav.classList)
            } 
            else {
                OpenMobileMenuButton.classList.remove("mainHeader_MobileButton_Active")
                MainHeaderNav?.classList.remove("mainHeader_Nav_MobileActive");
            } 
        }

        const IPButton:any | HTMLElement = document.getElementById("IPButton")
        IPButton.addEventListener("click", copiarIP)
        const OpenMobileMenuButton:any | HTMLElement = document.querySelector(".mainHeader_MobileButton");
        const MainHeaderNav:any | HTMLElement = document.querySelector(".mainHeader_Nav");

        console.log(OpenMobileMenuButton)
        OpenMobileMenuButton.addEventListener("click", MenuMovil)

</script>
