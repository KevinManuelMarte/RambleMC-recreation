<div class="notification">
    <p>¡IP COPIADA CORRECTAMENTE!</p>
</div>



<script>
    document.addEventListener("astro:page-load", ()=> {
        console.log("PERO TIO")
    function copiarIP() {
        navigator.clipboard.writeText("ramblemc.com:4000")
        window.alert("¡IP copiada correctamente!")
    }

    const IPButton:any | HTMLElement = document.getElementById("IPButton")
    IPButton.addEventListener("click", copiarIP)
    const OpenMobileMenuButton:any | HTMLElement = document.querySelector(".mainHeader_MobileButton");
    const MainHeaderNav:any | HTMLElement = document.querySelector(".mainHeader_Nav");

    OpenMobileMenuButton?.addEventListener("click", ()=> { 
        if (!MainHeaderNav?.classList.contains("mainHeader_Nav_MobileActive")){
            OpenMobileMenuButton.classList.add("mainHeader_MobileButton_Active")
            MainHeaderNav?.classList.add("mainHeader_Nav_MobileActive");
        } 
        else {
            OpenMobileMenuButton.classList.remove("mainHeader_MobileButton_Active")
            MainHeaderNav?.classList.remove("mainHeader_Nav_MobileActive");
        } 
    })
    })
</script>
