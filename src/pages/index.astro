---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';

//importing the background image for the "WELCOME" background
import minecraft_Wallpaper from '../assets/homepage/minecraft_Wallpaper.png';
//importing the background image for the "WELCOME" background


import orange_card_background from '../assets/homepage/orange_card_background.png';
//importing Ramble's logo
import ramble_logo from '../assets/ramble_logo.svg';
//importing Ramble's logo
---

<Layout Title="Ramble" Page='home'>

    <section class="homepage_WelcomeSection">
        <Image class="section_Background section_Background_InnerShadow" src={minecraft_Wallpaper} alt='Imagen de fondo de la sección de bienvenida'></Image>
        <section class="homepage_WelcomeSubSection_Padding">
            <h2 class="section_Title">¡BIENVENIDO A RAMBLE!</h2>
            <p class="section_Paragraph">Lorem ipsum dolor sit amet consectetur adipisicing elit. Nisi et atque incidunt officia? Ipsa cum repellendus 
                aliquid deserunt expedita ratione quas laudantium maiores laboriosam quod. Molestias earum quod aperiam fuga?</p>
        </section>
    </section>

    <section class="center">

        <h2 class="section_Title center">ULTIMAS NOTICIAS Y EVENTOS</h2>
        <p class="section_Paragraph center">¡Descubre las ultimas noticias y eventos de Ramble!</p>
        <div class="homepage_CardsContainer">
            <Card></Card> <Card></Card> <Card></Card>
        </div>
        <button class="section_Button center">VER TODO</button>

    </section>

    <section class="homepage_TransitionSection">
        <div class="homepage_OrangeCard">
            <Image alt="Fondo de la carta" src={orange_card_background} class="container_Background"></Image>

            <section>
                <h3 class="section_Title">CONECTATE</h3>
                <p class="section_Paragraph">Lorem ipsum dolor sit amet consectetur adipisicing elit. Aliquid iste quos praesentium ut ratione suscipit? Accusantium, exercitationem eveniet. Mollitia doloribus quidem minima aperiam atque nemo porro? Maiores accusamus quisquam quasi.</p>
            </section>
    
            <button class="section_Button section_Button_InversedColors">CONTACTARNOS</button>
        </div>
    </section>

    <section class="secondaryBackground section_Column center homepage_LastSection">
        <Image alt="Logo de Ramble" src={ramble_logo} class="section_MiniImage"></Image>
        <p class="section_Details section_Text_Gray">Visita nuestras redes sociales</p>
        <div>
            <button class="section_Button"><i class="fa-brands fa-square-facebook fa-2x"></i></button>
            <button class="section_Button"><i class="fa-brands fa-x-twitter fa-2x"></i></button>
        </div>
    </section>
</Layout>

