---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';


//importing the background image for the "WELCOME" background
import minecraft_Wallpaper from '../assets/homepage/minecraft_Wallpaper.png';

import orange_card_background from '../assets/homepage/orange_card_background.png';

//importing Ramble's logo
import ramble_logo from '../assets/ramble_logo.svg';

import { getCollection } from 'astro:content';

const Eventos = await getCollection('eventos');
const Noticias = await getCollection('noticias');

let TodasLasCartas:any[] = [];
let CartasDeNoticias:any[] = [];
let CartasDEventos:any[] = [];
let CartasAgregadas:number = 0;
const MaximaCantidadDeCartas:number = 2;


if (Eventos && !Noticias) {
    Eventos.sort((a:any, b:any) => {
        a = new Date (a.data.dateToSort);
        b = new Date (b.data.dateToSort);
        return a - b;
    })

    Eventos.reverse();

    Eventos.forEach((event) => {
        if (CartasAgregadas >= 1) {
            return;
        }
        CartasAgregadas++
        const NewProperty = {link: "eventos/"};
        const NewEvent = Object.assign(event, NewProperty)
        Eventos.unshift(NewEvent)
    })
}
else if (!Eventos && Noticias) {
    Noticias.sort((a:any, b:any) => {
        a = new Date (a.data.dateToSort);
        b = new Date (b.data.dateToSort);
        return a - b;
    })

    Noticias.reverse();

    Noticias.forEach((Noticias) => {
        if (CartasAgregadas >= 1) {
            return;
        }
        CartasAgregadas++
        const NewProperty = {link: "noticias/"};
        const NewNew = Object.assign(Noticias, NewProperty)
        CartasDeNoticias.unshift(NewNew)
    })
}
else if (Eventos && Noticias) {
    Eventos.sort((a:any, b:any) => {
        a = new Date (a.data.dateToSort);
        b = new Date (b.data.dateToSort);
        return a - b;
    })

    Eventos.reverse();

    Noticias.sort((a:any, b:any) => {
        a = new Date (a.data.dateToSort);
        b = new Date (b.data.dateToSort);
        return a - b;
    })

    Noticias.reverse();

    Eventos.forEach((event) => {
        if (CartasAgregadas >= 1) {
            return;
        }
        CartasAgregadas++
        const NewProperty = {link: "eventos/"};
        const NewEvent = Object.assign(event, NewProperty)
        Object.assign(Noticias, {noticia: false})
        return CartasDEventos.unshift(NewEvent)
    })
    Noticias.forEach((Noticias) => {
        if (CartasAgregadas >= MaximaCantidadDeCartas) {
            return;
        }
        CartasAgregadas++
        const NewProperty = {link: "noticias/"};
        const NewNew = Object.assign(Noticias, NewProperty)
        Object.assign(Noticias, {noticia: true})
        return CartasDeNoticias.unshift(NewNew)
    })

}

if (TodasLasCartas) {
    TodasLasCartas.sort((a:any, b:any) => {
        a = new Date (a.data.dateToSort);
        b = new Date (b.data.dateToSort);
        return a - b;
    })

    TodasLasCartas.reverse()
}

if (CartasDEventos) {
    CartasDEventos.sort((a:any, b:any) => {
        a = new Date (a.data.dateToSort);
        b = new Date (b.data.dateToSort);
        return a - b;
    })

    CartasDEventos.reverse()
}

if (CartasDeNoticias) {
    CartasDeNoticias.sort((a:any, b:any) => {
        a = new Date (a.data.dateToSort);
        b = new Date (b.data.dateToSort);
        return a - b;
    })

    CartasDeNoticias.reverse()
}


---

<Layout Title="Ramble" Pagina='inicio'>

    <section class="homepage_WelcomeSection">
        <Image class="section_Background section_Background_InnerShadow" src={minecraft_Wallpaper} alt='Imagen de fondo de la sección de bienvenida'></Image>
        <!-- <section class="homepage_WelcomeSubSection_Padding">
           <h2 class="section_Title">¡BIENVENIDO A RAMBLE!</h2>
            <p class="section_Paragraph">Lorem ipsum dolor sit amet consectetur adipisicing elit. Nisi et atque incidunt officia? Ipsa cum repellendus 
                aliquid deserunt expedita ratione quas laudantium maiores laboriosam quod. Molestias earum quod aperiam fuga?</p> 
        </section> -->
    </section>

    <section class="center">

        <h2 class="section_Title center">ULTIMAS NOTICIAS Y EVENTOS</h2>
        <p class="section_Paragraph center">¡Descubre las ultimas noticias y eventos de Ramble!</p>
        <div class="homepage_CardsContainer">
            {
                    CartasDEventos.map((carta:any) => {
                        return <div class="section_Card_HomepageContainer">
                        <Card Link={carta.link + carta.slug} Title={carta.data.title} Date={carta.data.date} ImgSRC={carta.data.img} Description={carta.data.description}></Card>
                        <a href="/eventos"><button class="section_Button center">VER EVENTOS</button></a>
                    </div>
                    })
            }

            {
                CartasDeNoticias.map((carta:any) => {
                    return <div class="section_Card_HomepageContainer">
                    <Card Link={carta.link + carta.slug} Title={carta.data.title} Date={carta.data.date} ImgSRC={carta.data.img} Description={carta.data.description}></Card>
                    <a href="/noticias"><button class="section_Button center">VER NOTICIAS</button></a>
                </div>
                })
            }
        </div>
    </section>

    <section class="homepage_TransitionSection">
        <div class="homepage_OrangeCard">
            <Image alt="Fondo de la carta" src={orange_card_background} class="container_Background"></Image>

            <section>
                <h3 class="section_Title">CONECTATE</h3>
                <p class="section_Paragraph">Lorem ipsum dolor sit amet consectetur adipisicing elit. Aliquid iste quos praesentium ut ratione suscipit? Accusantium, exercitationem eveniet. Mollitia doloribus quidem minima aperiam atque nemo porro? Maiores accusamus quisquam quasi.</p>
            </section>
    
            <button class="section_Button section_Button_InversedColors">CONTACTARNOS</button>
        </div>
    </section>

    <section class="secondaryBackground section_Column center homepage_LastSection">
        <Image alt="Logo de Ramble" src={ramble_logo} class="section_MiniImage"></Image>
        <p class="section_Paragraph section_Text_Gray">Visita nuestras redes sociales</p>
        <div>
            <button class="section_Button"><i class="fa-brands fa-square-facebook fa-2x"></i></button>
            <button class="section_Button"><i class="fa-brands fa-x-twitter fa-2x"></i></button>
        </div>
    </section>
</Layout>


