---
import { getCollection } from "astro:content"
import Layout from "../../layouts/Layout.astro";
export async function getStaticPaths () {
    const EventosCollection = await getCollection('eventos');
    return EventosCollection.map(Evento => ({
        params: {slug: Evento.slug}, props: {Evento},
    }));
}

const {Evento} = Astro.props;
const {Content} = await Evento.render();

export const prerender = true

---
<Layout Title="Ramble" Pagina="eventos">
    <article>
        <section class="article_Header">
            <h1 class="article_Title">{Evento.data.title}</h1>
            <h2 class="article_Date">{Evento.data.date}</h2>
        </section>

        <main class="article_Content">
            <Content />
        </main>
    </article>
</Layout>