---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
const EventosCollection = await getCollection('eventos');

EventosCollection.sort((a:any, b:any)=> {
    a = new Date(a.data.dateToSort);
    b  = new Date(b.data.dateToSort);
    return a - b;
})

EventosCollection.reverse()
---

<Layout Title="Ramble" Pagina='eventos'>
    <section id="Events" class="TwoColumnsCardContainer" >
        { EventosCollection.map(event => <a class="section_Card" href={"/eventos/" + event.slug}><img alt="Imagen de evento de Ramble" src={`${event.data.img}`} class="card_Image"></img><h4 class="card_Details">{event.data.date}</h4><h4 class="card_Title">{event.data.title}</h4><p class="card_Description">{event.data.description}</p></a>)}
    </section>
</Layout>

