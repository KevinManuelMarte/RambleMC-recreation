---
import { getCollection } from "astro:content"
import Layout from "../../layouts/Layout.astro";
export async function getStaticPaths () {
    const NoticiasCollection = await getCollection('noticias');
    return NoticiasCollection.map(Noticia => ({
        params: {slug: Noticia.slug}, props: {Noticia},
    }));
}

const {Noticia} = Astro.props;
const {Content} = await Noticia.render();


export const prerender = true
---
<Layout Title="Ramble" Pagina="noticias">
    <article>
        <section class="article_Header">
            <h1 class="article_Title">{Noticia.data.title}</h1>
            <h2 class="article_Date">{Noticia.data.date}</h2>
        </section>

        <main class="article_Content">
            <Content />
        </main>
    </article>
</Layout>