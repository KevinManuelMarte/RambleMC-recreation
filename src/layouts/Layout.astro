---
interface Props {
	Title: string;
	Page: string;
}

const { Title, Page } = Astro.props;

//Necessary componentes
import Header from '../components/Header.astro';
import Footer from "../components/Footer.astro";
//Necessary componentes


import "./styles.scss";
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Sitio web oficial del servidor de Minecraft 'Ramble'" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<script src="https://kit.fontawesome.com/c595e5d06f.js" crossorigin="anonymous"></script>
		<title>{Title}</title>
	</head>
	<body>
	<Header ActivePage={Page}></Header>
	<main>
		<slot />
	</main>
	<Footer></Footer>
	<!-- <Footer></Footer> -->
	</body>
</html>